<view class="chat-page">
  <loading-state
    wx:if="{{viewState === 'loading'}}"
    text="正在进入会话"
  />

  <view wx:elif="{{viewState === 'error'}}" class="chat-error surface-card">
    <empty-state
      title="会话暂时无法打开"
      description="{{errorMessage}}"
      action-text="重新加载"
      bind:action="retryConversation"
    />
    <button class="back-messages-button" bindtap="goMessages">返回消息</button>
  </view>

  <block wx:elif="{{viewState === 'success' && conversation}}">
    <view class="chat-header">
      <view class="other-user-row">
        <view class="chat-avatar">
          <image
            wx:if="{{conversation.otherUser.avatarUrl}}"
            class="chat-avatar-image"
            src="{{conversation.otherUser.avatarUrl}}"
            mode="aspectFill"
          />
          <text wx:else>{{conversation.otherUser.avatarText}}</text>
        </view>
        <view class="other-user-copy">
          <text class="other-user-name">{{conversation.otherUser.nickname}}</text>
          <text class="other-user-campus">{{conversation.otherUser.campus}}</text>
        </view>
      </view>

      <view class="product-card" bindtap="onProductTap">
        <image
          wx:if="{{conversation.product.coverImage}}"
          class="product-image"
          src="{{conversation.product.coverImage}}"
          mode="aspectFill"
        />
        <view class="product-copy">
          <text class="product-title">{{conversation.product.title}}</text>
          <view class="product-meta">
            <text class="product-price">{{conversation.product.priceDisplay}}</text>
            <text class="product-state product-state--{{conversation.product.status}}">
              {{conversation.product.statusText}}
            </text>
            <text wx:if="{{conversation.product.isCrossSchool}}" class="school-relation-badge">
              {{conversation.product.schoolRelationText}}
            </text>
          </view>
        </view>
        <text class="product-arrow">›</text>
      </view>

      <view
        class="appointment-entry {{appointmentError ? 'appointment-entry--unavailable' : ''}}"
        bindtap="onAppointmentTap"
      >
        <view class="appointment-entry-copy">
          <text class="appointment-entry-title">
            {{appointmentError ? '预约功能暂不可用' : (activeAppointment ? '查看面交预约' : '预约面交')}}
          </text>
          <text wx:if="{{appointmentError}}" class="appointment-entry-description">
            聊天不受影响，稍后可重新进入会话重试
          </text>
          <text wx:elif="{{activeAppointment}}" class="appointment-entry-description">
            {{activeAppointment.statusText}} · {{activeAppointment.scheduledAtText}}
          </text>
          <text wx:elif="{{conversation.product.isCrossSchool}}" class="appointment-entry-description">
            该商品属于其他学校，历史消息可继续查看和发送，但不能新建预约
          </text>
          <text wx:else class="appointment-entry-description">
            约定未来 30 天内的校园面交时间与地点
          </text>
        </view>
        <text class="product-arrow">›</text>
      </view>
    </view>

    <scroll-view
      class="message-scroll"
      scroll-y
      upper-threshold="80"
      scroll-into-view="{{scrollIntoView}}"
      bindscrolltoupper="loadEarlierMessages"
    >
      <view class="history-status">
        <loading-state
          wx:if="{{isLoadingEarlier}}"
          compact
          text="正在加载更早消息"
        />
        <view wx:elif="{{historyError}}" class="history-error">
          <text>{{historyError}}</text>
          <text class="history-retry" bindtap="retryHistory">重试</text>
        </view>
        <text wx:elif="{{!hasMore && messages.length > 0}}" class="history-end">
          已显示全部历史消息
        </text>
      </view>

      <view wx:if="{{messages.length === 0}}" class="chat-empty">
        <text class="chat-empty-title">开始聊聊这件闲置吧</text>
        <text class="chat-empty-description">请勿发送敏感信息，建议在校园公共区域面交</text>
      </view>

      <view
        wx:for="{{messages}}"
        wx:key="messageId"
        class="message-row {{item.type === 'system' ? 'message-row--system' : (item.isMine ? 'message-row--mine' : '')}}"
      >
        <view
          wx:if="{{item.type === 'system'}}"
          class="system-message-card"
          data-appointment-id="{{item.appointmentId}}"
          bindtap="openAppointmentMessage"
        >
          <text class="system-message-label">面交预约</text>
          <text class="system-message-content">{{item.content}}</text>
          <text class="system-message-action">查看详情 ›</text>
          <text class="system-message-time">{{item.createdAtText}}</text>
        </view>
        <view
          wx:else
          class="message-bubble message-bubble--{{item.type}} {{item.isMine ? 'message-bubble--mine' : ''}} {{item.sendStatus === 'failed' ? 'message-bubble--failed' : ''}}"
          data-client-message-id="{{item.clientMessageId}}"
          bindtap="retryMessage"
        >
          <text
            wx:if="{{item.type === 'text' || item.type === 'unsupported'}}"
            class="message-content"
            data-client-message-id="{{item.clientMessageId}}"
            catchtap="retryMessage"
          >{{item.content}}</text>

          <view
            wx:elif="{{item.type === 'voice'}}"
            class="voice-message"
            data-message-id="{{item.messageId}}"
            catchtap="onVoiceMessageTap"
          >
            <image
              class="voice-message__icon {{playingVoiceMessageId === item.messageId ? 'voice-message__icon--playing' : ''}}"
              src="/assets/icons/chat/voice-play.svg"
              mode="aspectFit"
            />
            <text class="voice-message__duration">{{item.media.durationText}}</text>
          </view>

          <image
            wx:elif="{{item.type === 'image'}}"
            class="message-image message-image--{{item.media.displayMode}}"
            src="{{item.localTempPath || item.media.fileId}}"
            mode="aspectFill"
            data-message-id="{{item.messageId}}"
            catchtap="onImageMessageTap"
          />

          <view
            wx:elif="{{item.type === 'location'}}"
            class="location-message"
            data-message-id="{{item.messageId}}"
            catchtap="openLocationMessage"
          >
            <view class="location-message__copy">
              <text class="location-message__name">{{item.location.name}}</text>
              <text class="location-message__address">{{item.location.address}}</text>
              <text class="location-message__action">查看位置</text>
            </view>
            <view class="location-message__map">
              <image
                class="location-message__icon"
                src="/assets/icons/chat/location.svg"
                mode="aspectFit"
              />
            </view>
          </view>

          <view
            wx:elif="{{item.type === 'product'}}"
            class="shared-product"
            data-message-id="{{item.messageId}}"
            data-product-id="{{item.product.productId}}"
            catchtap="openProductMessage"
          >
            <image
              wx:if="{{item.product.coverImage}}"
              class="shared-product__image"
              src="{{item.product.coverImage}}"
              mode="aspectFill"
            />
            <view wx:else class="shared-product__placeholder">
              <image
                class="shared-product__placeholder-icon"
                src="/assets/icons/chat/product.svg"
                mode="aspectFit"
              />
            </view>
            <view class="shared-product__copy">
              <text class="shared-product__title">{{item.product.title}}</text>
              <view class="shared-product__meta">
                <text class="shared-product__price">{{item.product.priceDisplay}}</text>
                <text class="shared-product__status">{{item.product.statusText}}</text>
              </view>
              <text class="shared-product__owner">
                {{item.product.ownerPublicUserId === conversation.otherUser.publicUserId ? '对方商品' : '我的商品'}}
              </text>
            </view>
          </view>

          <view class="message-meta">
            <text>{{item.createdAtText}}</text>
            <text wx:if="{{item.sendStatus === 'uploading'}}" class="send-state">
              上传中 {{item.uploadProgress}}%
            </text>
            <text wx:elif="{{item.sendStatus === 'sending'}}" class="send-state">发送中</text>
            <text wx:elif="{{item.sendStatus === 'failed'}}" class="send-state send-state--failed">
              发送失败，点此重试
            </text>
          </view>
        </view>
      </view>
      <view id="chat-bottom" class="chat-bottom-anchor"></view>
    </scroll-view>

    <view wx:if="{{!conversation.canSend}}" class="send-disabled-notice">
      商品已删除，当前会话仅可查看历史消息
    </view>
    <view
      wx:else
      class="chat-dock {{isExtensionPanelOpen ? 'chat-dock--expanded' : ''}}"
    >
      <view class="chat-composer">
        <button
          class="chat-composer__icon"
          aria-label="{{inputMode === 'text' ? '切换到语音输入' : '切换到文字输入'}}"
          bindtap="toggleInputMode"
        >
          <image
            class="chat-composer__icon-image"
            src="{{inputMode === 'text' ? '/assets/icons/chat/voice-switch.svg' : '/assets/icons/chat/keyboard.svg'}}"
            mode="aspectFit"
          />
        </button>

        <view class="chat-composer__main">
          <view wx:if="{{inputMode === 'text'}}" class="chat-composer__input-wrap">
            <textarea
              class="chat-composer__input"
              value="{{inputValue}}"
              maxlength="{{maxLength}}"
              auto-height
              adjust-position="{{true}}"
              disable-default-padding="{{true}}"
              show-confirm-bar="{{false}}"
              cursor-spacing="24"
              bindfocus="onTextInputFocus"
              bindinput="onInput"
            />
          </view>
          <view
            wx:else
            class="voice-record-button {{isRecording ? 'voice-record-button--active' : ''}}"
            hover-class="none"
            catchtouchstart="onVoiceTouchStart"
            catchtouchmove="onVoiceTouchMove"
            catchtouchend="onVoiceTouchEnd"
            catchtouchcancel="onVoiceTouchCancel"
          >
            <view class="voice-record-button__label">
              {{isCancellingVoice ? '松开取消' : (isRecording ? '松开发送' : (isPreparingRecording ? '正在准备' : '按住说话'))}}
            </view>
          </view>
        </view>

        <view class="chat-composer__right">
          <button
            wx:if="{{inputMode === 'voice' || !hasInputContent}}"
            class="chat-composer__icon chat-composer__plus"
            aria-label="{{isExtensionPanelOpen ? '收起更多功能' : '展开更多功能'}}"
            bindtap="toggleExtensionPanel"
          >
            <view class="chat-composer__plus-mark"></view>
          </button>
          <button
            wx:else
            class="chat-composer__send"
            disabled="{{sendDisabled}}"
            bindtap="sendMessage"
          >
            {{isSending ? '发送中' : '发送'}}
          </button>
        </view>
      </view>

      <view
        wx:if="{{isExtensionPanelOpen}}"
        class="extension-panel"
      >
        <button class="extension-item" bindtap="onAlbumTap">
          <view class="extension-item__icon-wrap">
            <image class="extension-item__icon" src="/assets/icons/chat/gallery.svg" mode="aspectFit" />
          </view>
          <text class="extension-item__label">相册</text>
        </button>
        <button class="extension-item" bindtap="onCameraTap">
          <view class="extension-item__icon-wrap">
            <image class="extension-item__icon" src="/assets/icons/chat/camera.svg" mode="aspectFit" />
          </view>
          <text class="extension-item__label">拍摄</text>
        </button>
        <button class="extension-item" bindtap="onLocationTap">
          <view class="extension-item__icon-wrap">
            <image class="extension-item__icon" src="/assets/icons/chat/location.svg" mode="aspectFit" />
          </view>
          <text class="extension-item__label">位置</text>
        </button>
        <button class="extension-item" bindtap="openProductPicker">
          <view class="extension-item__icon-wrap">
            <image class="extension-item__icon" src="/assets/icons/chat/product.svg" mode="aspectFit" />
          </view>
          <text class="extension-item__label">发送商品</text>
        </button>
      </view>
    </view>

    <view
      wx:if="{{isPreparingRecording || isRecording}}"
      class="recording-overlay"
    >
      <view class="recording-card {{isCancellingVoice ? 'recording-card--cancel' : ''}}">
        <image
          class="recording-card__icon"
          src="/assets/icons/chat/voice-switch.svg"
          mode="aspectFit"
        />
        <text class="recording-card__duration">{{recordingDuration}} 秒</text>
        <text class="recording-card__hint">
          {{isCancellingVoice ? '松开手指，取消发送' : '手指上滑，取消发送'}}
        </text>
      </view>
    </view>
  </block>
</view>
