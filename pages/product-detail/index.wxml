<view class="page-shell--plain detail-page">
  <loading-state
    wx:if="{{viewState === 'loading'}}"
    text="正在加载商品详情"
  />

  <view wx:elif="{{showErrorState}}" class="detail-error">
    <view class="surface-card detail-error-card">
      <empty-state
        title="{{errorTitle}}"
        description="{{errorDescription}}"
        action-text="{{errorActionText}}"
        action-class="detail-error-action-button"
        bind:action="onErrorAction"
      />
      <button
        wx:if="{{canRetry}}"
        class="detail-error-action-button detail-home-button"
        bindtap="goHome"
      >
        返回首页
      </button>
    </view>
  </view>

  <block wx:elif="{{viewState === 'success' && product}}">
    <view class="detail-cover detail-cover--{{product.coverTone}}">
      <swiper
        wx:if="{{mediaImages.length > 0}}"
        class="detail-swiper"
        current="{{currentImageIndex}}"
        circular="{{mediaImages.length > 1}}"
        duration="260"
        bindchange="onImageSwiperChange"
      >
        <swiper-item
          wx:for="{{mediaImages}}"
          wx:key="key"
          class="detail-slide"
        >
          <image
            wx:if="{{!item.failed}}"
            class="detail-image"
            src="{{item.url}}"
            mode="aspectFill"
            data-index="{{index}}"
            bindtap="onPreviewProductImage"
            binderror="onProductImageError"
          />
          <view wx:else class="detail-image-fallback">
            <text class="detail-cover-label">{{product.coverLabel}}</text>
            <text class="detail-image-fallback__text">图片暂时无法加载</text>
          </view>
        </swiper-item>
      </swiper>
      <view wx:else class="detail-image-fallback">
        <text class="detail-cover-label">{{product.coverLabel}}</text>
        <text class="detail-image-fallback__text">卖家暂未提供有效图片</text>
      </view>
      <text wx:if="{{mediaImages.length > 0}}" class="detail-page-indicator">
        {{currentImageIndex + 1}} / {{mediaImages.length}}
      </text>
      <text class="detail-status detail-status--{{product.statusClass}}">
        {{product.statusText}}
      </text>
      <text class="detail-condition">{{product.condition}}</text>
    </view>

    <view wx:if="{{product.video}}" class="surface-card detail-video-card">
      <view class="detail-video-heading">
        <view>
          <view class="section-title">商品演示视频</view>
          <view class="detail-video-tip">点击播放，默认不会自动播放</view>
        </view>
        <text class="detail-video-duration">{{product.video.duration}} 秒</text>
      </view>
      <video
        wx:if="{{!videoLoadFailed}}"
        id="product-demo-video"
        class="detail-video"
        src="{{product.video.fileID}}"
        poster="{{product.video.posterFileID}}"
        controls
        autoplay="{{false}}"
        loop="{{false}}"
        object-fit="contain"
        show-center-play-btn
        enable-progress-gesture
        binderror="onProductVideoError"
      />
      <view wx:else class="detail-video-error">
        视频暂时无法播放，不影响查看商品图片和文字信息
      </view>
    </view>

    <view
      wx:if="{{isCrossSchoolReadonly}}"
      class="status-notice status-notice--cross-school"
    >
      {{readonlyNotice}}
    </view>

    <view wx:if="{{product.isReserved}}" class="status-notice status-notice--reserved">
      该商品当前已预定，可继续联系卖家，但不能创建或接受新的预约
    </view>

    <view wx:if="{{product.isSold}}" class="status-notice status-notice--sold">
      该商品已完成线下面交，仅保留详情展示
    </view>

    <view class="surface-card detail-main">
      <view class="detail-price-row">
        <view class="detail-price-group">
          <text class="price-value {{product.priceText === '免费送' ? 'price-value--free' : ''}}">
            {{product.priceDisplay}}
          </text>
          <text wx:if="{{product.hasOriginalPrice}}" class="original-price">
            {{product.originalPriceDisplay}}
          </text>
        </view>
        <text class="category-name">{{product.categoryName}}</text>
      </view>

      <view class="detail-title">{{product.title}}</view>

      <view class="tag-list">
        <text wx:for="{{product.tags}}" wx:key="*this" class="tag-item">
          {{item}}
        </text>
      </view>

      <view class="stats-row">
        <text>{{product.viewCountText}} 人浏览 · {{product.favoriteCountText}} 人收藏</text>
      </view>
    </view>

    <view class="surface-card detail-section">
      <view class="section-title">物品描述</view>
      <view class="description-text">{{product.description}}</view>
    </view>

    <view class="surface-card detail-section">
      <view class="section-title">商品信息</view>
      <view class="info-list">
        <view class="info-row">
          <text class="info-label">分类</text>
          <text class="info-value">{{product.categoryName}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">成色</text>
          <text class="info-value">{{product.condition}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">发布时间</text>
          <text class="info-value">{{product.publishedAtText}}</text>
        </view>
        <view wx:if="{{product.schoolName}}" class="info-row">
          <text class="info-label">发布校园</text>
          <text class="info-value info-value--wrap">{{product.schoolName}}</text>
        </view>
        <view wx:elif="{{isOwnProduct}}" class="info-row">
          <text class="info-label">发布校园</text>
          <text class="info-value info-value--wrap">历史商品：未标校园</text>
        </view>
        <view class="info-row">
          <text class="info-label">面交地点</text>
          <text class="info-value info-value--wrap">{{product.locationName}}</text>
        </view>
        <view class="info-row info-row--last">
          <text class="info-label">交易方式</text>
          <text class="info-value">{{product.distanceText}}</text>
        </view>
      </view>
    </view>

    <view
      class="surface-card seller-card {{isCrossSchoolReadonly ? 'seller-card--readonly' : ''}}"
      bindtap="onSellerTap"
    >
      <view class="seller-avatar">{{product.seller.initial}}</view>
      <view class="seller-info">
        <view class="seller-name-row">
          <text class="seller-name">{{product.seller.nickname}}</text>
          <text wx:if="{{product.seller.verified}}" class="verified-badge">已认证</text>
        </view>
        <text class="seller-note">{{product.campus}} · 普通校园用户</text>
      </view>
      <view class="seller-link">
        <text>{{isCrossSchoolReadonly ? '仅展示信息' : '查看主页'}}</text>
        <text wx:if="{{!isCrossSchoolReadonly}}" class="seller-arrow">›</text>
      </view>
    </view>

    <view class="safety-card">
      <view class="safety-icon">安</view>
      <view class="safety-copy">
        <text class="safety-title">校园面交提示</text>
        <text class="safety-description">
          请在校园公共区域面交，确认物品状态后再完成交易。
        </text>
      </view>
    </view>

    <view class="detail-actions">
      <button
        wx:if="{{!isOwnProduct}}"
        class="secondary-button action-button favorite-button {{isFavorited ? 'favorite-button--active' : ''}}"
        disabled="{{isFavoriteLoading || (!isFavorited && !canFavorite)}}"
        bindtap="onFavoriteTap"
      >
        {{isFavoriteLoading ? '处理中' : (isFavorited ? '★ 已收藏' : '☆ 收藏')}}
      </button>
      <button
        class="primary-button action-button action-button--main {{isOwnProduct || isCrossSchoolReadonly ? 'action-button--disabled' : ''}}"
        disabled="{{isOwnProduct || isCrossSchoolReadonly || isContactLoading}}"
        bindtap="onContactTap"
      >
        {{isOwnProduct ? '这是我的商品' : (isCrossSchoolReadonly ? '其他学校 · 仅可查看' : (isContactLoading ? '正在进入会话' : '联系卖家'))}}
      </button>
    </view>
  </block>
</view>
