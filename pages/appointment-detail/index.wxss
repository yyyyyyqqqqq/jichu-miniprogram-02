.appointment-detail-page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.error-card {
  padding-bottom: 24rpx;
}

.status-card,
.product-card,
.info-card,
.timeline-card {
  padding: 26rpx;
}

.product-card,
.info-card,
.timeline-card {
  margin-top: 20rpx;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-label,
.section-title {
  color: #2c3a33;
  font-size: 27rpx;
  font-weight: 680;
}

.status-badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff3dc;
  color: #a66a11;
  font-size: 21rpx;
}

.status-badge--accepted,
.status-badge--completed {
  background: #e9f7f0;
  color: #13865a;
}

.status-badge--rejected,
.status-badge--cancelled {
  background: #eef1ef;
  color: #737d78;
}

.status-description {
  display: block;
  margin-top: 14rpx;
  color: #7b8680;
  font-size: 23rpx;
  line-height: 1.55;
}

.product-card {
  display: flex;
  align-items: center;
}

.product-image {
  width: 112rpx;
  height: 112rpx;
  flex: none;
  border-radius: 18rpx;
  background: #edf2ef;
}

.product-copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
  margin-left: 18rpx;
}

.product-title {
  overflow: hidden;
  color: #2b3932;
  font-size: 26rpx;
  font-weight: 680;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  margin-top: 8rpx;
  color: #ef5d42;
  font-size: 25rpx;
  font-weight: 700;
}

.product-role {
  margin-top: 9rpx;
  color: #7f8984;
  font-size: 21rpx;
}

.row-arrow {
  color: #a2aaa6;
  font-size: 40rpx;
}

.info-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf1ef;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  width: 150rpx;
  flex: none;
  color: #7d8782;
  font-size: 23rpx;
}

.info-value,
.location-copy {
  min-width: 0;
  flex: 1;
  color: #334139;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: right;
}

.location-copy {
  display: flex;
  flex-direction: column;
}

.location-address {
  margin-top: 7rpx;
  color: #7c8781;
  font-size: 21rpx;
}

.map-link {
  margin-top: 8rpx;
  color: #159160;
  font-size: 21rpx;
}

.timeline-row {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  color: #5d6962;
  font-size: 23rpx;
}

.timeline-dot {
  width: 14rpx;
  height: 14rpx;
  flex: none;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #16a36a;
}

.timeline-dot--ended {
  background: #9ba49f;
}

.chat-button {
  margin-top: 22rpx;
}

.action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  gap: 14rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e4ebe7;
  background: #ffffff;
}

.action-button {
  min-width: 0;
  height: 74rpx;
  flex: 1;
  margin: 0;
  border-radius: 18rpx;
  font-size: 23rpx;
  line-height: 74rpx;
}

.action-button--primary {
  background: #16a36a;
  color: #ffffff;
}

.action-button--muted {
  background: #edf2ef;
  color: #68736d;
}

.action-button--danger {
  background: #fff0ed;
  color: #c65443;
}
