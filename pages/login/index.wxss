.login-page {
  padding-top: 54rpx;
}

.login-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 20rpx 42rpx;
  text-align: center;
}

.login-logo {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  border-radius: 36rpx;
  background: #16a36a;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 750;
  box-shadow: 0 16rpx 34rpx rgba(22, 163, 106, 0.2);
}

.login-card {
  padding: 34rpx 30rpx;
}

.identity-note {
  padding: 24rpx;
  border-radius: 18rpx;
  background: #edf8f3;
}

.identity-note__title {
  color: #26352d;
  font-size: 28rpx;
  font-weight: 700;
}

.identity-note__text {
  margin-top: 12rpx;
  color: #5f786b;
  font-size: 23rpx;
  line-height: 1.7;
}

.field-label {
  color: #34423b;
  font-size: 25rpx;
  font-weight: 700;
}

.field-label--spaced {
  margin-top: 30rpx;
}

.avatar-picker {
  width: 144rpx;
  height: 144rpx;
  margin: 18rpx 0 0;
  padding: 0;
  overflow: hidden;
  border: 2rpx dashed #abd9c5;
  border-radius: 42rpx;
  background: #f0faf5;
  line-height: 1;
}

.avatar-preview,
.avatar-empty {
  width: 100%;
  height: 100%;
}

.avatar-preview {
  display: block;
}

.avatar-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #4c8e70;
  font-size: 21rpx;
}

.avatar-empty-icon {
  margin-bottom: 10rpx;
  font-size: 42rpx;
  font-weight: 300;
}

.field-hint {
  margin-top: 12rpx;
  color: #8b9590;
  font-size: 21rpx;
  line-height: 1.65;
}

.profile-input {
  height: 82rpx;
  margin-top: 14rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dfe8e3;
  border-radius: 18rpx;
  background: #f8faf9;
  color: #26352d;
  font-size: 26rpx;
}

.login-status-note {
  margin-top: 24rpx;
  color: #69766f;
  font-size: 23rpx;
  text-align: center;
}

.login-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #fff1ee;
  color: #bd513e;
  font-size: 23rpx;
  line-height: 1.55;
}

.retry-link {
  flex: none;
  margin-left: 18rpx;
  color: #13865a;
  font-weight: 700;
}

.wechat-login-button {
  width: 100%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  border-radius: 24rpx;
  background: #16a36a;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.wechat-login-button[disabled] {
  background: #a8d6c2;
  color: rgba(255, 255, 255, 0.92);
}

.back-button {
  margin-top: 18rpx;
  background: transparent;
  color: #68746e;
  font-size: 24rpx;
  line-height: 2.2;
}

.privacy-note {
  padding: 28rpx 38rpx 0;
  color: #89928d;
  font-size: 21rpx;
  line-height: 1.7;
  text-align: center;
}
