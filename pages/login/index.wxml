<view class="page-shell--plain login-page">
  <view class="login-hero">
    <view class="login-logo">即</view>
    <view class="page-title">{{isProfileStep ? '完善微信资料' : '登录即出'}}</view>
    <view class="page-subtitle">
      {{isProfileStep ? '确认本次登录使用的头像和昵称' : '使用微信身份登录后，可进入校园闲置交易服务'}}
    </view>
  </view>

  <view class="surface-card login-card">
    <block wx:if="{{!isProfileStep}}">
      <view class="identity-note">
        <view class="identity-note__title">可信微信身份</view>
        <view class="identity-note__text">
          登录只确认当前微信身份。身份建立后，将由你主动确认头像和昵称。
        </view>
      </view>

      <view wx:if="{{isRestoring}}" class="login-status-note">正在确认登录状态…</view>

      <button
        class="wechat-login-button"
        loading="{{isSubmitting || isLoggingIn}}"
        disabled="{{isSubmitting || isLoggingIn || isRestoring || isReturning}}"
        bindtap="onLoginTap"
      >
        微信登录
      </button>
    </block>

    <block wx:else>
      <view class="field-label">微信头像</view>
      <button
        class="avatar-picker"
        open-type="chooseAvatar"
        disabled="{{isSubmitting || isUpdatingProfile || isReturning}}"
        bindchooseavatar="onChooseAvatar"
      >
        <image
          wx:if="{{avatarPreviewUrl}}"
          class="avatar-preview"
          src="{{avatarPreviewUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="avatar-empty">
          <text class="avatar-empty-icon">＋</text>
          <text>选择头像</text>
        </view>
      </button>
      <text class="field-hint">使用微信官方头像选择能力，也可以确认历史头像</text>

      <view class="field-label field-label--spaced">微信昵称</view>
      <input
        class="profile-input"
        type="nickname"
        maxlength="20"
        value="{{nickname}}"
        placeholder="请输入 1～20 个字符"
        disabled="{{isSubmitting || isUpdatingProfile || isReturning}}"
        bindinput="onNicknameInput"
      />

      <button
        class="wechat-login-button"
        loading="{{isSubmitting || isUpdatingProfile}}"
        disabled="{{isSubmitting || isUpdatingProfile || isReturning}}"
        bindtap="onConfirmProfileTap"
      >
        {{isReturning ? '正在进入' : '确认并继续'}}
      </button>
    </block>

    <view wx:if="{{errorMessage}}" class="login-error">
      <text>{{errorMessage}}</text>
      <text
        wx:if="{{authStatus === 'error' && !isProfileStep}}"
        class="retry-link"
        bindtap="onRetryRestore"
      >重新校验</text>
    </view>

    <button class="back-button" bindtap="onBackTap">暂不登录，返回</button>
  </view>

  <view class="privacy-note">
    身份只由微信上下文确认；头像昵称仅作公开展示，不会修改学校、换校冷却或历史关系。
  </view>
</view>
