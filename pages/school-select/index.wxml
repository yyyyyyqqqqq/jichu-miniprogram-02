<view class="page-shell--plain school-select-page">
  <view class="school-hero">
    <view class="school-mark">校</view>
    <view class="page-title">{{pageTitle}}</view>
    <view class="page-subtitle">
      {{pageSubtitle}}
    </view>
  </view>

  <view wx:if="{{schoolUnavailable}}" class="unavailable-tip">
    <text class="unavailable-title">当前学校暂不可用</text>
    <text class="unavailable-copy">
      {{currentSchoolName ? '原学校“' + currentSchoolName + '”暂未开放，请重新选择。' : '原学校信息暂不可用，请重新选择。'}}
    </text>
  </view>

  <view
    wx:if="{{isChangeMode}}"
    class="cooldown-card {{canChangeSchool ? 'cooldown-card--ready' : 'cooldown-card--locked'}}"
  >
    <text class="cooldown-title">
      {{canChangeSchool ? '当前可以修改学校' : '学校修改冷却中'}}
    </text>
    <text class="cooldown-copy">{{cooldownText}}</text>
  </view>

  <view class="surface-card school-panel">
    <view class="search-box">
      <text class="search-icon">⌕</text>
      <input
        class="school-search-input"
        maxlength="40"
        value="{{keyword}}"
        placeholder="学校名称前缀或 10 位学校标识码"
        confirm-type="search"
        disabled="{{isSubmitting || isConfirming || isReturning}}"
        bindinput="onKeywordInput"
        bindconfirm="onSearchConfirm"
      />
      <button
        wx:if="{{keyword}}"
        class="search-clear"
        disabled="{{isSubmitting || isConfirming || isReturning}}"
        bindtap="onClearSearch"
      >
        清除
      </button>
    </view>

    <picker
      mode="selector"
      range="{{provinceOptions}}"
      value="{{provinceIndex}}"
      disabled="{{isSubmitting || isConfirming || isReturning}}"
      bindchange="onProvinceChange"
    >
      <view class="province-picker">
        <text class="province-label">省级地区</text>
        <text class="province-value">{{province || '全部地区'}}⌄</text>
      </view>
    </picker>

    <loading-state
      wx:if="{{viewState === 'loading'}}"
      text="{{isSearching ? '正在搜索学校' : '正在加载开放学校'}}"
    />

    <empty-state
      wx:elif="{{viewState === 'error'}}"
      title="学校加载失败"
      description="{{errorMessage}}"
      action-text="重新加载"
      bind:action="onRetry"
    />

    <empty-state
      wx:elif="{{viewState === 'empty'}}"
      title="{{isSearching ? '没有找到开放学校' : '暂时没有开放学校'}}"
      description="{{isSearching ? '换个关键词试试，或清除搜索查看全部。' : '请稍后重试或联系平台运营人员。'}}"
      action-text="{{isSearching ? '清除搜索' : '重新加载'}}"
      bind:action="onEmptyAction"
    />

    <view wx:elif="{{viewState === 'success'}}" class="school-list">
      <button
        wx:for="{{schools}}"
        wx:key="id"
        data-id="{{item.id}}"
        class="school-item {{currentSchoolId === item.id ? 'school-item--current' : ''}}"
        disabled="{{isSubmitting || isConfirming || isReturning || (isChangeMode && !canChangeSchool)}}"
        bindtap="onSchoolTap"
      >
        <view class="school-item-copy">
          <text class="school-name">{{item.name}}</text>
          <text class="school-meta">
            {{item.province}}{{item.city && item.city !== item.province ? ' · ' + item.city : ''}} · {{item.educationLevel}}
          </text>
        </view>
        <text class="school-action">
          {{selectedSchoolId === item.id && isSubmitting ? '提交中' : (currentSchoolId === item.id ? '当前学校' : (isChangeMode ? '修改为此校' : '选择'))}}
        </text>
      </button>
      <view class="pagination-footer">
        <text wx:if="{{discardedCount > 0}}" class="window-note">
          为保持流畅，已释放前 {{discardedCount}} 所学校；可用搜索或省级地区快速定位。
        </text>
        <text wx:if="{{loadMoreError}}" class="load-more-error">{{loadMoreError}}</text>
        <button
          wx:if="{{hasMore}}"
          class="load-more-button"
          loading="{{isLoadingMore}}"
          disabled="{{isLoadingMore || isSubmitting || isConfirming || isReturning}}"
          bindtap="onLoadMore"
        >
          {{isLoadingMore ? '加载中' : '加载更多'}}
        </button>
        <text wx:else class="list-end">已显示当前条件下的全部学校</text>
      </view>
    </view>

    <view wx:if="{{errorMessage && viewState !== 'error'}}" class="submit-error">
      {{errorMessage}}
    </view>
  </view>

  <view class="selection-note">
    {{isChangeMode ? '学校修改由服务端校验，成功后 7 天内不可再次修改；旧商品和历史关系不会迁移或删除。' : '学校名称与开放状态由云端权威数据校验，不能通过自由文本修改。'}}
  </view>
  <button
    class="logout-button"
    disabled="{{isSubmitting || isConfirming || isReturning}}"
    bindtap="onLogoutTap"
  >
    退出当前登录
  </button>
</view>
