.school-select-page {
  padding-top: 42rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.school-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 20rpx 38rpx;
  text-align: center;
}

.school-mark {
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 26rpx;
  border-radius: 34rpx;
  background: #16a36a;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 750;
  box-shadow: 0 16rpx 34rpx rgba(22, 163, 106, 0.2);
}

.unavailable-tip {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #f0d3a9;
  border-radius: 20rpx;
  background: #fff8ea;
}

.unavailable-title {
  color: #995f0e;
  font-size: 25rpx;
  font-weight: 700;
}

.unavailable-copy {
  margin-top: 8rpx;
  color: #927044;
  font-size: 22rpx;
  line-height: 1.6;
}

.cooldown-card {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #dce8e1;
  border-radius: 20rpx;
}

.cooldown-card--ready {
  background: #eff9f4;
}

.cooldown-card--locked {
  border-color: #f0d3a9;
  background: #fff8ea;
}

.cooldown-title {
  color: #2e5d47;
  font-size: 25rpx;
  font-weight: 700;
}

.cooldown-card--locked .cooldown-title {
  color: #995f0e;
}

.cooldown-copy {
  margin-top: 8rpx;
  color: #6e8076;
  font-size: 22rpx;
  line-height: 1.6;
}

.cooldown-card--locked .cooldown-copy {
  color: #927044;
}

.school-panel {
  min-height: 420rpx;
  padding: 26rpx;
}

.search-box {
  position: relative;
  height: 82rpx;
  display: flex;
  align-items: center;
  padding: 0 94rpx 0 18rpx;
  border: 1rpx solid #dfe8e3;
  border-radius: 20rpx;
  background: #f8faf9;
}

.search-icon {
  flex: none;
  margin-right: 12rpx;
  color: #6d7a73;
  font-size: 34rpx;
}

.school-search-input {
  min-width: 0;
  height: 80rpx;
  flex: 1;
  color: #26352d;
  font-size: 26rpx;
}

.province-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #e7ece9;
  border-radius: 18rpx;
  background: #f8faf9;
}

.province-label {
  color: #66736c;
  font-size: 25rpx;
}

.province-value {
  color: #173d2d;
  font-size: 25rpx;
  font-weight: 650;
}

.pagination-footer {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 14rpx;
  padding-top: 22rpx;
  text-align: center;
}

.window-note,
.list-end {
  color: #849089;
  font-size: 22rpx;
  line-height: 1.55;
}

.load-more-error {
  color: #c8473b;
  font-size: 22rpx;
}

.load-more-button {
  height: 76rpx;
  border: 1rpx solid #cce8da;
  border-radius: 18rpx;
  background: #eff9f4;
  color: #167a52;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 74rpx;
}

.load-more-button::after {
  border: 0;
}

.search-clear {
  position: absolute;
  top: 50%;
  right: 6rpx;
  width: 76rpx;
  min-width: 76rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: none;
  margin: 0;
  padding: 0 6rpx 0 0;
  transform: translateY(-50%);
  background: transparent;
  color: #168b5e;
  font-size: 23rpx;
  line-height: 56rpx;
  text-align: right;
}

.school-list {
  margin-top: 22rpx;
}

.school-item {
  width: 100%;
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0;
  padding: 22rpx 20rpx;
  border-bottom: 1rpx solid #edf1ef;
  border-radius: 0;
  background: #ffffff;
  color: #1f2a25;
  line-height: normal;
  text-align: left;
}

.school-item:last-child {
  border-bottom: 0;
}

.school-item[disabled] {
  opacity: 0.65;
}

.school-item--current {
  background: #f2faf6;
}

.school-item-copy {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
  padding-right: 20rpx;
}

.school-name {
  overflow: hidden;
  color: #26352d;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.school-meta {
  margin-top: 9rpx;
  color: #87918c;
  font-size: 22rpx;
  line-height: 1.45;
}

.school-action {
  min-width: 76rpx;
  flex: none;
  color: #168b5e;
  font-size: 24rpx;
  font-weight: 650;
  text-align: center;
}

.submit-error {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #fff1ee;
  color: #bd513e;
  font-size: 23rpx;
  line-height: 1.55;
}

.selection-note {
  margin: 24rpx 16rpx 0;
  color: #89938e;
  font-size: 21rpx;
  line-height: 1.7;
  text-align: center;
}

.logout-button {
  height: 70rpx;
  margin-top: 14rpx;
  background: transparent;
  color: #78837d;
  font-size: 24rpx;
  line-height: 70rpx;
}
